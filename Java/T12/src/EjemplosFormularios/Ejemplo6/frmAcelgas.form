<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="EjemplosFormularios.Ejemplo6.frmAcelgas">
  <grid id="27dc6" binding="panel1" default-binding="true" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="815e6" binding="panelInferior" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="4d684" class="javax.swing.JLabel" binding="lbResultado">
            <constraints/>
            <properties>
              <text value=""/>
            </properties>
          </component>
          <component id="225cc" class="javax.swing.JButton" binding="btGenerar">
            <constraints/>
            <properties>
              <text value="Generar"/>
            </properties>
          </component>
          <component id="f3bc5" class="javax.swing.JButton" binding="btSalir">
            <constraints/>
            <properties>
              <text value="Salir"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="d245e" binding="panelCentral" layout-manager="GridBagLayout">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="98d3d" class="javax.swing.JTextField" binding="tfNum2">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <opaque value="true"/>
              <preferredSize width="162" height="45"/>
              <text value=""/>
            </properties>
          </component>
          <component id="832ba" class="javax.swing.JTextField" binding="tfNum1">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <preferredSize width="162" height="45"/>
              <text value=""/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="3149b" binding="panelSuperior" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="62c4f" class="javax.swing.JRadioButton" binding="rbtSumar">
            <constraints/>
            <properties>
              <selected value="true"/>
              <text value="Sumar"/>
            </properties>
          </component>
          <component id="972" class="javax.swing.JRadioButton" binding="rbtRestar">
            <constraints/>
            <properties>
              <text value="Restar"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
