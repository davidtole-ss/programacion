<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="EjemplosFormularios.frm3.formulario3">
  <grid id="27dc6" binding="panel1" default-binding="true" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <background color="-16318331"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="1f4ad" binding="PanelSuperior" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="North"/>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="f73e7" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <foreground color="-327697"/>
              <text value="Bienvenido"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="9d178" binding="PanelInferior" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="2">
        <constraints border-constraint="South"/>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="b9312" class="javax.swing.JButton" binding="aceptarButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="Aceptar"/>
            </properties>
          </component>
          <component id="bfd5d" class="javax.swing.JButton" binding="salirButton" default-binding="true">
            <constraints/>
            <properties>
              <horizontalAlignment value="0"/>
              <text value="Salir"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="b00de" binding="PanelCentral" layout-manager="GridBagLayout">
        <constraints border-constraint="Center"/>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="fa89c" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="0" left="0" bottom="0" right="10" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <foreground color="-327697"/>
              <text value="Nombre: "/>
            </properties>
          </component>
          <component id="6b011" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="0" left="0" bottom="0" right="10" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <foreground color="-327697"/>
              <text value="Apellidos: "/>
            </properties>
          </component>
          <component id="30e20" class="javax.swing.JTextField" binding="textField1" default-binding="true">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <preferredSize width="100" height="34"/>
              <text value=""/>
            </properties>
          </component>
          <component id="55b12" class="javax.swing.JTextField" binding="textField2" default-binding="true">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <preferredSize width="100" height="34"/>
              <text value=""/>
            </properties>
          </component>
        </children>
