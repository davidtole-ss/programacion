<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="EjemplosFormularios.frm1.formulario">
  <grid id="27dc6" binding="panel1" layout-manager="GridBagLayout">
